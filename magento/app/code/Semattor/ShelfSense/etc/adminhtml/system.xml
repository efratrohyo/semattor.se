<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="semattor_shelfsense" translate="label" sortOrder="900" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>ShelfSense – smart category sorting</label>
            <tab>catalog</tab>
            <resource>Semattor_ShelfSense::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Only changes categories where you chose something other than "Standard". Other categories are never touched.</comment>
                </field>
                <field id="cron_expr" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>When to update the order (cron)</label>
                    <comment>Default: 15 3 * * * (every night at 03:15). When you save a category, its order is also updated right away.</comment>
                </field>
                <field id="out_of_stock_last" translate="label" type="select" sortOrder="30" showInDefault="1">
                    <label>Sold out products last</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="bestseller" translate="label" sortOrder="20" showInDefault="1">
                <label>Best sellers</label>
                <field id="days" translate="label" type="text" sortOrder="10" showInDefault="1">
                    <label>Count sales from the last X days</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
            <group id="smart" translate="label comment" sortOrder="30" showInDefault="1">
                <label>Most relevant (smart)</label>
                <comment>Score = sales (recent sales count double) + new product boost + your own position numbers. The weights are relative to each other, for example 50 / 25 / 25.</comment>
                <field id="weight_sales" translate="label" type="text" sortOrder="10" showInDefault="1">
                    <label>Weight: sales</label>
                    <validate>validate-digits</validate>
                </field>
                <field id="weight_new" translate="label" type="text" sortOrder="20" showInDefault="1">
                    <label>Weight: new product</label>
                    <validate>validate-digits</validate>
                </field>
                <field id="weight_manual" translate="label" type="text" sortOrder="30" showInDefault="1">
                    <label>Weight: your position numbers</label>
                    <validate>validate-digits</validate>
                </field>
                <field id="new_half_life_days" translate="label comment" type="text" sortOrder="40" showInDefault="1">
                    <label>New product boost halves every X days</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="trend_days" translate="label comment" type="text" sortOrder="50" showInDefault="1">
                    <label>Recent sales window (days)</label>
                    <comment>Sales in this window count double.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
        </section>
    </system>
</config>
