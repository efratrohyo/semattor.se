<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <semattor_shelfsense>
            <general>
                <enabled>1</enabled>
                <cron_expr>15 3 * * *</cron_expr>
                <out_of_stock_last>1</out_of_stock_last>
                <top_count>300</top_count>
                <interval_days>2</interval_days>
                <own_brand_first>1</own_brand_first>
                <test_place>5</test_place>
                <brand_attribute>brand</brand_attribute>
                <own_brands>SE Mattor</own_brands>
            </general>
            <bestseller>
                <days>90</days>
            </bestseller>
            <auto>
                <tracking>1</tracking>
                <min_days>14</min_days>
                <min_views>1000</min_views>
                <sample_rate>50</sample_rate>
                <exploration>15</exploration>
                <window_days>28</window_days>
                <min_product_views>30</min_product_views>
            </auto>
            <smart>
                <weight_sales>50</weight_sales>
                <weight_new>25</weight_new>
                <weight_manual>25</weight_manual>
                <new_half_life_days>30</new_half_life_days>
                <trend_days>30</trend_days>
            </smart>
        </semattor_shelfsense>
    </default>
</config>
