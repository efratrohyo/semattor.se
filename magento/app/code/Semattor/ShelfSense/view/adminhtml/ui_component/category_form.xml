<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <fieldset name="shelfsense" sortOrder="45">
        <settings>
            <label translate="true">ShelfSense Sorting</label>
            <collapsible>true</collapsible>
        </settings>

        <field name="shelfsense_mode" formElement="select" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">category</item>
                    <item name="component" xsi:type="string">Semattor_ShelfSense/js/form/mode-cards</item>
                    <item name="elementTmpl" xsi:type="string">Semattor_ShelfSense/form/mode-cards</item>
                    <item name="imports" xsi:type="array">
                        <item name="autoStatus" xsi:type="string">${ $.parentName }.shelfsense_preview:autoStatus</item>
                    </item>
                    <item name="cards" xsi:type="array">
                        <item name="standard" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Standard</item>
                            <item name="text" xsi:type="string" translate="true">Lowest position number first. ShelfSense does not touch this category.</item>
                        </item>
                        <item name="newest" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Newest first</item>
                            <item name="text" xsi:type="string" translate="true">The product added last comes first (highest product ID).</item>
                        </item>
                        <item name="smart" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Most relevant</item>
                            <item name="text" xsi:type="string" translate="true">A mix: 50% sales, 25% new products, 25% your position numbers. Best sellers on top, but new products and your choices still get a chance.</item>
                        </item>
                        <item name="auto" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Auto (learning)</item>
                            <item name="text" xsi:type="string" translate="true">Learns from what customers see, click and buy here. Tests products it knows little about in a few places and moves up what sells. Unlocks when there is enough data.</item>
                        </item>
                        <item name="bestseller" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Best sellers</item>
                            <item name="text" xsi:type="string" translate="true">Most units sold in the last 90 days first. All sizes and all countries count together.</item>
                        </item>
                    </item>
                </item>
            </argument>
            <settings>
                <dataType>string</dataType>
                <label translate="true">Sort "Populärt" by</label>
                <notice translate="true">Customers only see the new order, never the name of the option. Sold out products go last. The order updates when you save and every 2 days at night (setting). While another option than Standard is active, "Products in Category" shows your Standard position numbers. You can change them any time. Customers see those changes when you go back to Standard.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Semattor\ShelfSense\Model\Source\SortMode"/>
                    </settings>
                </select>
            </formElements>
        </field>

        <field name="shelfsense_pinned_skus" formElement="input" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">category</item>
                    <item name="placeholder" xsi:type="string">SKU1, SKU2, SKU3</item>
                    <item name="imports" xsi:type="array">
                        <item name="visible" xsi:type="string">${ $.parentName }.shelfsense_mode:hasActiveMode</item>
                    </item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Pinned on top (optional)</label>
                <notice translate="true">Products you always want first. Put a comma between SKUs: SKU1, SKU2, SKU3. The first SKU is shown first. No limit. Pinned products go above everything else. If a pinned product is sold out, it goes last until it is back in stock. For products with sizes, use the main SKU.</notice>
            </settings>
        </field>

        <container name="shelfsense_preview" sortOrder="30">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Semattor_ShelfSense/js/form/preview</item>
                    <item name="template" xsi:type="string">Semattor_ShelfSense/form/preview</item>
                    <item name="previewUrl" xsi:type="url" path="shelfsense/preview/index"/>
                    <item name="imports" xsi:type="array">
                        <item name="mode" xsi:type="string">${ $.parentName }.shelfsense_mode:value</item>
                        <item name="pinned" xsi:type="string">${ $.parentName }.shelfsense_pinned_skus:value</item>
                        <item name="categoryId" xsi:type="string">${ $.provider }:data.entity_id</item>
                    </item>
                </item>
            </argument>
        </container>
    </fieldset>
</form>
