<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <fieldset name="shelfsense" sortOrder="45">
        <settings>
            <label translate="true">ShelfSense – smart sortering</label>
            <collapsible>true</collapsible>
        </settings>
        <field name="shelfsense_mode" formElement="select" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">category</item>
                </item>
            </argument>
            <settings>
                <dataType>string</dataType>
                <label translate="true">Sortera produkter efter</label>
                <notice translate="true">"Standard" = kategorin visas precis som idag under "Populärt". Väljer du något annat ändrar ShelfSense vad kunden ser under "Populärt" (sparar och varje natt). Går du tillbaka till "Standard" återställs den gamla ordningen exakt.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Semattor\ShelfSense\Model\Source\SortMode"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="shelfsense_pinned_skus" formElement="textarea" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">category</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Fäst SKU:er överst (valfritt)</label>
                <notice translate="true">En SKU per rad (eller kommaseparerat). Visas först i exakt denna ordning, resten sorteras enligt valet ovan. Används bara när ett sorteringsval är aktivt.</notice>
            </settings>
        </field>
    </fieldset>
</form>
