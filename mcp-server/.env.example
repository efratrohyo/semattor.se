# Reference only. Claude Desktop does NOT read .env files — these values go in
# the "env" block of %APPDATA%\Claude\claude_desktop_config.json.
#
# This file exists so you can set the same variables in PowerShell when running
# smoke_test.py or MCP Inspector by hand:
#
#   $env:GOOGLE_APPLICATION_CREDENTIALS = "C:\Users\Shei\Documents\Code Claude Windows\secrets\ga4-sa.json"
#   $env:GA4_DEFAULT_SITE = "GA4 se"

# REQUIRED - absolute path to the service-account JSON key.
# One key covers all five properties. Keep it OUTSIDE this folder.
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\Shei\Documents\Code Claude Windows\secrets\ga4-sa.json

# OPTIONAL - which property tools use when no `site` argument is given.
# Defaults to "GA4 se" if unset. Accepts "GA4 dk", "dk", or a numeric ID.
GA4_DEFAULT_SITE=GA4 se

# OPTIONAL - default Search Console property when no site_url is given.
# Defaults to sc-domain:semattor.se. Accepts a full siteUrl:
#   "sc-domain:example.com"    domain property
#   "https://www.example.com/" URL-prefix property (trailing slash matters)
# Run list_gsc_sites to see the exact strings before setting this.
GSC_DEFAULT_SITE=sc-domain:semattor.se

# RECOMMENDED on Windows - forces UTF-8 so non-ASCII page titles don't break
# the stdio transport under the cp1252 console code page.
PYTHONUTF8=1
